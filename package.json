{
  "name": "telegram-claude",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "auto-pr": "bun run scripts/auto-pr/index.ts",
    "lint": "bunx --bun ultracite check",
    "fix": "bunx --bun ultracite fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "logs": "bash scripts/logs.sh runs",
    "logs:errors": "bash scripts/logs.sh errors",
    "logs:stats": "bash scripts/logs.sh stats",
    "logs:follow": "bash scripts/logs.sh follow",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.173",
    "@effect/platform-bun": "4.0.0-beta.78",
    "@openai/codex-sdk": "0.139.0",
    "effect": "4.0.0-beta.78",
    "execa": "^9.6.1",
    "grammy": "^1.44.0",
    "groq-sdk": "^0.37.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "typescript": "^5.7.0",
    "ultracite": "7.2.3"
  }
}
