{
  "name": "netxjs-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts",
      "tools/oxlint/anti-slop"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "bunx --bun ultracite check --type-aware",
    "dev": "turbo dev",
    "fix": "bunx --bun ultracite fix --type-aware",
    "format": "bun run fix",
    "lint": "bun run check",
    "prepare": "husky",
    "provider-settings:sync": "bun run packages/agent/scripts/provider-settings-sync.ts",
    "typecheck": "turbo typecheck",
    "upgrade": "bun run scripts/upgrade.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.94.0",
    "@types/bun": "^1.4.1",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "oxfmt": "0.66.0",
    "oxlint": "1.94.0",
    "portless": "^0.15.6",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "ultracite": "7.10.8"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "@openai/codex-sdk@0.171.0": "patches/@openai%2Fcodex-sdk@0.171.0.patch"
  }
}
