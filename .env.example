BOT_TOKEN=your_telegram_bot_token
ALLOWED_USER_ID=your_telegram_user_id
PROJECTS_DIR=/home/agent/projects
GROQ_API_KEY=your_groq_api_key

# The one directory the assistant works in. Set it and the project picker is
# gone: user files live at its root, this repo is cloned at
# <WORK_DIR>/owner-telegram-bot. Leave it blank for the PROJECTS_DIR layout.
# WORK_DIR=/home/bot/workspace

# Where the codex CLI is. Leave it blank and the bot finds it at boot: PATH
# first, then ~/.local/bin, ~/bin, ~/.bun/bin, ~/.codex/bin. Set it when codex
# lives somewhere else — a systemd unit does not inherit the PATH your shell
# rc file builds, so `which codex` in a terminal is not what the service sees.
# No variable turns a provider on or off: an installed, logged-in CLI is used.
# CODEX_BIN=/home/bot/.local/bin/codex

# Where Claude Code is, for runs. Leave it blank and runs use the claude binary
# the agent SDK ships, pinned with it. A `claude` on PATH (or in ~/.local/bin,
# ~/bin, ~/.bun/bin, ~/.claude/local) only tells the bot Claude is installed;
# log it in as the service account with `claude auth login`. An override
# moves with that install's own updates. It must be the native binary, not a
# .js entry; a bare name is looked up on the service's PATH. Anything else
# leaves Claude `unsupported`.
# CLAUDE_BIN=/home/bot/.local/bin/claude

# Where pi is. Leave it blank and the bot finds it at boot: PATH first, then
# ~/.pi/agent/bin (the managed installer, pinned at 1.6.x), ~/.local/bin,
# ~/bin, ~/.bun/bin.
# PI_BIN=/home/bot/.pi/agent/bin/pi

# The model pi answers on, as provider/id. Leave it blank and pi's own
# default in ~/.pi/agent/settings.json is used; with neither, pi is off.
# PI_DEFAULT_MODEL=openrouter/z-ai/glm-5.2

# The model pi's light runs (groups, guests, members, Business replies), topic
# titles, the format pass and the address judge's fallback use, as provider/id.
# A model picked in /settings («Группы и гости» -> Модель) wins over it for
# light runs, titles and formatting, and one picked in «Служебные проходы» ->
# Модель wins for its own pass. Leave it blank for the default.
# Those runs get no provider key from this file (not GROQ_API_KEY either), so
# its provider needs a key in pi's auth.json or models.json; a model keyed
# only here is skipped for them, and the default is used.
# PI_LIGHT_MODEL=openrouter/openai/gpt-oss-20b

# Where bubblewrap is. Leave it blank and the bot uses `bwrap` from PATH
# (apt install bubblewrap). Found and working, every run that is not full
# access starts inside the sandbox view; without it Codex runs under its own
# sandbox only, and Claude refuses members. Claude members need socat too.
# BWRAP_BIN=/usr/bin/bwrap

# Where socat is. Leave it blank and the bot uses `socat` from PATH
# (apt install socat). Found and working, every sandbox view gets its own
# network and reaches only its provider's hosts through the bot's proxy.
# Without it Claude refuses members.
# SOCAT_BIN=/usr/bin/socat

# Codex slug per model tier (luna, terra, sol, astra). Unset => each tier runs
# on the newest of its built-in slugs the account lists in models_cache.json.
# A tier left out is not offered: picks for it move to the nearest tier given.
# Light runs, the judge, the formatter and topic titles use the luna slug.
# CODEX_TIER_MODELS=luna=gpt-6-luna,terra=gpt-5.6-terra,sol=gpt-6.2-sol,astra=gpt-6.2-astra

# Claude slug per model tier. Unset => the full id of the haiku, sonnet, opus
# and fable aliases in Claude Code's own model list. A slug the account does
# not offer is dropped with a warning.
# CLAUDE_TIER_MODELS=luna=claude-haiku-5-5,terra=claude-sonnet-5-5,sol=claude-opus-5-5,astra=claude-fable-5-2

# Optional (defaults shown). Keep each comment on its own line: systemd's
# EnvironmentFile reads a trailing `# ...` as part of the value.
# IANA zone new reminders use; shown without a label. The time zone row of
# /settings overrides it.
# DEFAULT_TZ=Europe/Sofia
# Agent runs at once; the /settings row overrides it
# MAX_CONCURRENT_RUNS=4
# Conversations waiting on background work at once, apart from the limit above
# MAX_BACKGROUND_RUNS=20
# Codex auto-compacts a session once its context passes this; the Порог сжатия
# row of /settings → Провайдеры → Codex overrides it
# CODEX_AUTO_COMPACT_TOKENS=150000
# Relative paths resolve inside the repo-root .data/
# TG_LOG_FILE=events.jsonl
# pretty | logfmt | json; defaults to pretty on a TTY, logfmt otherwise
# LOG_FORMAT=
# All|Fatal|Error|Warn|Info|Debug|Trace|None
# LOG_LEVEL=Info

# Executor (cloud, executor.sh) — wired into the agent as an MCP server so it
# can reach external integrations (Notion, GitHub, Vercel, PostHog, …).
# Sources are configured in the Executor dashboard, not here. Leave either value
# blank to run without Executor (the default).
# Org-scoped endpoint from the Executor dashboard: v1 is
# https://executor.sh/<org>/mcp, v2 is https://mcp.executor.sh/org/<org>/mcp
# EXECUTOR_MCP_URL=https://executor.sh/org_xxx/mcp
# API key (v1: a v1 API key; v2: a personal access token, exp_…); sent as
# `Authorization: Bearer <key>`, handed to Codex through its env, never argv;
# Claude calls go through the bot
# EXECUTOR_API_KEY=
# v1 | v2: how script tasks are replayed (v1: REST /api/executions, v2: MCP
# execute). Blank: v2 for a URL on mcp.executor.sh, else v1. Self-hosted
# Executor sets it itself
# EXECUTOR_VERSION=

# TypeSafe (typesafe.ai) — four judgments: which model and effort a new
# conversation runs on, whether the call name in a group or Business message
# was an address or a mention, whether a scheduled report really did its work,
# and whether a message asks for a reminder the keyword scan missed. Leave it
# blank (the default): the router answers Terra at medium effort, the address
# judge falls back to a one-turn pass on the helper provider (Codex, Claude or
# pi, or the one picked in «Служебные проходы»), the other two are skipped.
# API key from the TypeSafe dashboard
# TYPESAFE_API_KEY=

# ElevenLabs (elevenlabs.io): voice replies. A run asked to answer by voice
# speaks its answer and sends it as a Telegram voice message; the voice and
# model are picked in /settings -> Голосовые ответы. Blank: voice replies are
# off and the run answers in text. Needs ffmpeg on the host.
# ELEVENLABS_API_KEY=

# Telegram account (MTProto) — lets owner runs read the owner's own chats and,
# with a confirmation button by default, send, forward, edit and delete as
# them. Get the pair at https://my.telegram.org -> API development tools. Leave
# both blank (the default) and the feature is off. Log in from chat: /login.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# confirm | direct (direct: no button, scheduled tasks send unattended).
# The confirm row of /settings overrides it.
# TELEGRAM_ACCOUNT_WRITES=confirm
# Loopback port runs reach the account on; 0 = any free port
# TELEGRAM_ACCOUNT_MCP_PORT=0

# HTTP API — programs (ChatGPT through Executor, Codex, webhooks, scripts)
# call the bot with a key from /apikeys, acting as the person who made it.
# On with true/yes/on/1/y; off with false/no/off/0/n or unset. Any other value
# (True too) stops the bot at boot. It binds 127.0.0.1 only: put a reverse
# proxy with HTTPS in front (README: HTTP API). See docs/http-api.md.
# API_ENABLED=false
# Loopback port it listens on
# API_PORT=8787
# The https address clients use, through your proxy; named in /openapi.json
# API_PUBLIC_URL=https://bot.example.com

# Observability: the local .data/events.jsonl ledger is always on. Optionally
# ALSO send logs (each run event included) and traces to a cloud OTel backend
# by setting an endpoint (+ headers). Unset = local only (the default).
# Example: Axiom —
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xaat-...,X-Axiom-Dataset=owner-telegram-bot
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
