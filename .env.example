BOT_TOKEN=your_telegram_bot_token
ALLOWED_USER_ID=your_telegram_user_id
PROJECTS_DIR=/home/agent/projects
GROQ_API_KEY=your_groq_api_key

# Optional (sensible defaults shown) — see README "Optional configuration"
# CLAUDE_SETTINGS_JSON={"permissions":{"deny":[]}}   # override the hardened Claude Agent SDK settings
# MAX_CONCURRENT_RUNS=4
# RUN_TIMEOUT_MS=                                     # unset = unbounded (/stop only)
# TG_LOG_FILE=.data/events.jsonl
# LOG_FORMAT=pretty                                   # pretty | logfmt | json
# LOG_LEVEL=Info
# DRAFT_INTERVAL_MS=300
# SPLIT_AT=4000
# ANTHROPIC_API_KEY=                                  # optional Docker/CI fallback; unset = subscription login

# Executor (cloud, executor.sh) — wired into both providers as an MCP server so
# the agent can reach external integrations (Notion, GitHub, Vercel, PostHog, …).
# Sources are configured in the Executor dashboard, not here. Leave either value
# blank to run without Executor (the default).
# EXECUTOR_MCP_URL=https://executor.sh/org_xxx/mcp    # org-scoped endpoint from the Executor dashboard
# EXECUTOR_API_KEY=                                   # API key; sent as `Authorization: Bearer <key>`

# Observability: local .data/events.jsonl is always on. Optionally ALSO forward
# each RunEvent to a cloud OTel backend by setting an endpoint (+ headers).
# Unset = local-only (the default). Example: Axiom —
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xaat-...,X-Axiom-Dataset=telegram-claude
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
